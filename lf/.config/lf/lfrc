# LF replacement for the Ranger setup.

set shell sh
set shellopts '-eu'
set ifs "\n"

# Ranger-like layout and behaviour.
set ratios 1:3:4
set scrolloff 8
set hidden false
set hiddenfiles ".*:*.pyc:*.pyo:*.bak:*.swp:*.aux:*.nav:*.snm:*.toc:*.log:*.synctex.gz:*.prv:*.fls:*.fdb_latexmk:*.blg:lost+found:__pycache__:_region_.tex"
set sortby natural
set sortignorecase true
set dirfirst true
set info size
set dircounts true
set history true
set mouse false
set preview true
set period 2
set promptfmt "\033[34;1m%d\033[0m\033[1m%f\033[0m"
set previewer ~/.config/lf/preview.sh

# File opening: text in the editor, Org in Emacs, everything else in the
# platform opener. "o" asks which application to use.
cmd open $~/.config/lf/open.sh $fx
cmd open-with $~/.config/lf/open.sh --ask $fx

# Match Ranger's mkdir prompt: treat the full name as one path.
cmd mkdir ${{
    IFS=' '
    mkdir -p -- "$*"
}}

# Ranger was configured to delete without confirmation. "D" is the safer
# recoverable alternative on macOS and on Linux systems with trash-cli.
cmd delete ${{
    set -f
    rm -rf -- $fx
}}
cmd trash ${{
    set -f
    if command -v trash >/dev/null 2>&1; then
        trash $fx
    elif command -v trash-put >/dev/null 2>&1; then
        trash-put -- $fx
    else
        printf 'No trash command found\n' >&2
        exit 1
    fi
}}

# Keep the useful archive helpers from the previous LF config.
cmd extract ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f ;;
        *.tar.gz|*.tgz) tar xzvf $f ;;
        *.tar.xz|*.txz) tar xJvf $f ;;
        *.zip) unzip $f ;;
        *.rar) unrar x $f ;;
        *.7z) 7z x $f ;;
    esac
}}
cmd tar ${{
    set -f
    mkdir "$1"
    cp -r $fx "$1"
    tar czf "$1.tar.gz" "$1"
    rm -rf -- "$1"
}}
cmd zip ${{
    set -f
    mkdir "$1"
    cp -r $fx "$1"
    zip -r "$1.zip" "$1"
    rm -rf -- "$1"
}}

cmd paste-overwrite $~/.config/lf/paste-overwrite.sh
cmd paste-symlink ${{
    set -f
    for src in $fx; do ln -s -- "$src" .; done
}}
cmd paste-relative-symlink ${{
    set -f
    for src in $fx; do
        rel=$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$src" "$PWD")
        ln -s -- "$rel" .
    done
}}
cmd paste-hardlink ${{
    set -f
    for src in $fx; do ln -- "$src" .; done
}}
cmd paste-hardlinked-subtree ${{
    set -f
    for src in $fx; do cp -Rlp -- "$src" .; done
}}

cmd dir-size ${{
    if du -hd 1 . >/dev/null 2>&1; then
        du -hd 1 .
    else
        du --max-depth=1 -h --apparent-size .
    fi
}}
cmd dir-size-sorted ${{
    if du -hd 1 . >/dev/null 2>&1; then
        du -hd 1 . | sort -rh
    else
        du --max-depth=1 -h --apparent-size . | sort -rh
    fi
}}
cmd tag-clear :tag; tag-toggle

# Colemak navigation.
map n down
map e up
map h updir
map i open
map <up> up
map <down> down
map <left> updir
map <right> open
map J half-down
map H jump-prev
map L jump-next

# General commands.
map q quit
map Q quit!
map R reload
map <c-r> reload
map <c-l> redraw
map ? push :help<enter>
map s $SHELL
map ; read
map o open-with
map O open-with
map mk push :mkdir<space>
map E $$EDITOR $fx
map l $~/.config/lf/preview.sh $f | less -R
map P $mail2print.sh $f
map <enter> shell
map X !$f

# Selection and bookmarks.
map <space> toggle
map v invert
map V visual
map u
map t tag-toggle
map ut tag-clear
map m
map mm mark-save

# Common directories from Ranger.
map gh cd ~
map gd cd ~/Downloads
map ga cd ~/academia
map gc cd ~/academia/code
map gp cd ~/ucloud/my_stuff/papers
map gi cd ~/ucloud/my_stuff/Personal/investing
map gs cd ~/ucloud/my_stuff/Personal/investing/stocks
map gb cd ~/bin
map gu cd ~/ucloud/my_stuff

# File operations. LF's shared server makes yy in one client available to pp
# in another client automatically.
map y
map yy copy
map yp ${{
    if command -v pbcopy >/dev/null 2>&1; then
        printf %s "$f" | pbcopy
    else
        printf %s "$f" | xclip -selection clipboard
    fi
}}
map d
map dd cut
map ud clear
map uy clear
map p
map pp paste
map po paste-overwrite
map pl paste-symlink
map pL paste-relative-symlink
map phl paste-hardlink
map pht paste-hardlinked-subtree
map x delete
map df delete
map D trash

# Rename, permissions, searching and display toggles.
map rn rename
map ra rename
map A rename
map I rename
map = push $chmod<space>
map / search
map k search-next
map K search-prev
map du dir-size
map dU dir-size-sorted
map zh set hidden!
map <c-h> set hidden!
map zd set dirfirst!
map zp set preview!
map zs set sortignorecase!
map zm set mouse!
map zP set dirpreviews!
map zu set dircounts!
map zf filter

